{
  "name": "git-pad",
  "version": "0.1.11",
  "description": "A mobile-first GitHub sync plugin for Obsidian.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "release": "node release.mjs",
    "version": "node version-bump.mjs && pnpm run indent:write && git add manifest.json versions.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "indent:write": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "onlyBuiltDependencies": ["esbuild"]
}
